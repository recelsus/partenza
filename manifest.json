{
  "manifest_version": 3,
  "name": "Partenza Bookmark",
  "version": "0.1.0",
  "description": "Bookmark source and cache extension for GitHub and HTTP static files.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Partenza Bookmark",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+2"
      }
    },
    "add-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Add current tab to bookmarks"
    }
  },
  "options_page": "options.html"
}
